# Môi trường Laravel (Sau này đổi thành production khi deploy)
APP_NAME="Digital Travel ERP (PHP)"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Thông tin kết nối MySQL (Đổi lại mật khẩu khi bạn chạy thật)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travel_erp
DB_USERNAME=root
DB_PASSWORD=

# JWT secret phải được sinh riêng cho từng môi trường deploy.
# Chạy: php artisan jwt:secret
JWT_SECRET=

# URL của Frontend React để cấu hình CORS cho phép gọi API
FRONTEND_URL=http://localhost:3000

# VNPAY Sandbox Configuration
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua

# Chi bat mock payment o local/testing hoac demo co kiem soat
PAYMENT_MOCK_ENABLED=false

POWERBI_READONLY_USERNAME=powerbi_readonly
POWERBI_READONLY_PASSWORD=

# Optional: duong dan SQL seed noi bo trong repo be-php
SEED_SQL_TAI_KHOAN_PATH=../database-scripts/seed-data/accounts_seed.sql
SEED_SQL_KHOI_TAO_PATH=../database-scripts/seed-data/business_demo_seed.sql
