# Môi trường Laravel (Sau này đổi thành production khi deploy)
APP_NAME="Digital Travel ERP (PHP)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Thông tin kết nối MySQL (Đổi lại mật khẩu khi bạn chạy thật)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travel_erp
DB_USERNAME=root
DB_PASSWORD=

# === RẤT QUAN TRỌNG: JWT_SECRET ĐỒNG BỘ TỪ JAVA ===
# (Tuyệt đối không chạy lệnh php artisan jwt:secret để sinh lại key này, nếu không token cũ sẽ chết hết)
JWT_SECRET=ZGlnaXRhbC10cmF2ZWwtZXJwLXNlY3JldC1rZXktbXVzdC1iZS00Mi1jaGFycy1sb25nLW1pbg==

# URL của Frontend React để cấu hình CORS cho phép gọi API
